# Dependencies
/node_modules/

# Frontend build output and caches
/build/
/dist/
/.svelte-kit/
/package/
/coverage/
/.vite/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tauri / Rust build output
/src-tauri/target/
/src-tauri/gen/schemas/
/src-tauri/**/*.rs.bk
/src/lib/generated/commands.ts
/src/lib/generated/bindings/
/src-tauri/bindings/

# Environment and local overrides
.env
.env.*
!.env.example
!.env.sample

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and local tooling
.claude/
.worktrees/
.idea/
.trae/
.vscode/
.fleet/
.zed/
*.iml
*.swp
*.swo
*~
.cache/
.eslintcache
